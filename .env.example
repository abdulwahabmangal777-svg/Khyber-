# ==============================================================================
# Saudi Fleet & Workforce Management System - Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://fleet_user:fleet_secure_pass_2026@localhost:5432/saudi_fleet_db?schema=public
DIRECT_URL=postgresql://fleet_user:fleet_secure_pass_2026@localhost:5432/saudi_fleet_db?schema=public

# Authentication & JWT Secrets
JWT_SECRET=saudi_fleet_super_secure_jwt_secret_key_2026_x9910
JWT_REFRESH_SECRET=saudi_fleet_refresh_token_secret_key_2026_r9910
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Google Maps Platform Configuration
VITE_GOOGLE_MAPS_API_KEY=

# AI Voice Assistant & Gemini GenAI Configuration
GEMINI_API_KEY=
VOICE_AI_PROVIDER=gemini
AI_CONFIDENCE_THRESHOLD=0.85
VOICE_RETENTION_DAYS=90

# S3 Object Storage / Document Archival
STORAGE_ENDPOINT=https://s3.me-central-1.amazonaws.com
STORAGE_BUCKET=saudi-fleet-documents-prod
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Redis Cache & Background Jobs
REDIS_URL=redis://localhost:6379

# SMTP Email Notification Relay
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@saudifleet.com.sa

# SMS Gateway (Saudi Unifonic / Mobily API)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=SAUDIFLEET
