// Prisma Schema for Fleet & Workforce Management System (Saudi Arabia)
// Database: PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  HR
  ACCOUNTANT
  FLEET_MANAGER
  VIEWER
}

enum WorkerStatus {
  ACTIVE
  VACATION
  INACTIVE
  TERMINATED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SOLD
}

enum OwnershipType {
  OWNED
  LEASED
  RENTED
}

enum FuelType {
  GASOLINE_91
  GASOLINE_95
  DIESEL
  ELECTRIC
  HYBRID
}

enum VehicleDocType {
  REGISTRATION
  INSURANCE
  INSPECTION
  PURCHASE
  OTHER
}

enum WorkerDocType {
  IQAMA
  PASSPORT
  WORK_PERMIT
  MEDICAL_INSURANCE
  DRIVER_LICENSE
  CONTRACT
  OTHER
}

enum InspectionResult {
  PASSED
  FAILED
  PENDING
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  OIL_CHANGE
  TIRE_REPLACEMENT
  BRAKE_SERVICE
  ENGINE_OVERHAUL
  PERIODIC_SERVICE
  OTHER
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  INSURANCE
  REGISTRATION
  INSPECTION
  TIRES
  SPARE_PARTS
  FINES
  TOLLS_SALIK
  OTHER
}

enum AlertStatus {
  VALID
  EXPIRING_60
  EXPIRING_30
  EXPIRING_15
  EXPIRING_7
  EXPIRING_1
  EXPIRED
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  DOWNLOAD
  UPLOAD
  EXPORT
  RESTORE
  BACKUP
}

// ----------------------------------------------------
// RBAC & USERS
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  username     String    @unique
  phone        String?
  passwordHash String
  role         UserRole  @default(VIEWER)
  departmentId String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  
  // Relations
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  notifications Notification[]
  uploadedFiles FileRecord[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "vehicle.create", "worker.delete"
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@map("permissions")
}

// ----------------------------------------------------
// DEPARTMENTS
// ----------------------------------------------------

model Department {
  id          String    @id @default(uuid())
  name        String
  nameAr      String?
  code        String    @unique
  managerId   String?
  description String?
  isActive    Boolean   @default(true)

  // Relations
  users       User[]
  vehicles    Vehicle[]
  workers     Worker[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([code])
  @@map("departments")
}

// ----------------------------------------------------
// WORKERS / EMPLOYEES
// ----------------------------------------------------

model Worker {
  id                         String       @id @default(uuid())
  employeeId                 String       @unique // e.g. "EMP-1001"
  fullName                   String
  fullNameAr                 String?
  nationality                String       @default("Saudi")
  nationalityAr              String?
  dateOfBirth                DateTime?
  gender                     String?      // "MALE", "FEMALE"
  jobTitle                   String
  departmentId               String?
  phone                      String       // Saudi mobile
  email                      String?
  iqamaNumber                String       @unique // 10 digits
  iqamaExpiryDate            DateTime?
  passportNumber             String?
  passportExpiryDate         DateTime?
  workPermitNumber           String?
  workPermitExpiryDate       DateTime?
  medicalInsuranceNumber     String?
  medicalInsuranceExpiryDate DateTime?
  contractStartDate          DateTime?
  contractEndDate            DateTime?
  joiningDate                DateTime?
  salary                     Decimal      @default(0.0) @db.Decimal(12, 2)
  driverLicenseNumber        String?
  driverLicenseExpiryDate    DateTime?
  assignedVehicleId          String?
  address                    String?
  emergencyContactName       String?
  emergencyContactPhone      String?
  status                     WorkerStatus @default(ACTIVE)
  notes                      String?      @db.Text
  profilePhotoUrl            String?

  // Relations
  department                 Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedVehicle            Vehicle?             @relation("CurrentVehicleDriver", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignments                VehicleAssignment[]
  documents                  WorkerDocument[]
  fuelRecords                FuelRecord[]
  expenses                   ExpenseRecord[]
  expiryAlerts               ExpiryAlert[]

  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  deletedAt                  DateTime?

  @@index([employeeId])
  @@index([iqamaNumber])
  @@index([passportNumber])
  @@index([phone])
  @@index([status])
  @@index([iqamaExpiryDate])
  @@index([passportExpiryDate])
  @@index([driverLicenseExpiryDate])
  @@map("workers")
}

// ----------------------------------------------------
// VEHICLES
// ----------------------------------------------------

model Vehicle {
  id                     String        @id @default(uuid())
  vehicleId              String        @unique // Internal Fleet code e.g. "FLT-101"
  plateNumber            String        @unique // e.g. "7845 XYZ"
  plateDigits            String        // "7845"
  plateLettersEn         String        // "XYZ"
  plateDigitsAr          String?       // "٧٨٤٥"
  plateLettersAr         String?       // "س ص ع"
  plateType              String?       @default("PRIVATE") // PRIVATE, COMMERCIAL, TRANSPORT
  make                   String        // Toyota, Mercedes-Benz, Isuzu
  model                  String        // Hilux, Actros, D-Max
  year                   Int
  color                  String
  vin                    String        @unique // 17-char VIN
  chassisNumber          String?
  engineNumber           String?
  ownershipType          OwnershipType @default(OWNED)
  departmentId           String?
  currentLocation        String?
  status                 VehicleStatus @default(ACTIVE)
  
  // Registration / Istimara
  registrationNumber     String?
  registrationExpiryDate DateTime?
  
  // Insurance
  insuranceCompany       String?
  insurancePolicyNumber  String?
  insuranceExpiryDate    DateTime?
  
  // Periodic Inspection (MVPI / Fahs)
  inspectionDate         DateTime?
  inspectionExpiryDate   DateTime?
  
  purchaseDate           DateTime?
  purchasePrice          Decimal?      @default(0.0) @db.Decimal(12, 2)
  currentMileage         Int           @default(0)
  fuelType               FuelType      @default(DIESEL)
  notes                  String?       @db.Text
  photoUrl               String?

  // Relations
  department             Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  currentDrivers         Worker[]              @relation("CurrentVehicleDriver")
  assignments            VehicleAssignment[]
  documents              VehicleDocument[]
  insurances             VehicleInsurance[]
  registrations          VehicleRegistration[]
  inspections            VehicleInspection[]
  maintenanceRecords     MaintenanceRecord[]
  fuelRecords            FuelRecord[]
  expenses               ExpenseRecord[]
  expiryAlerts           ExpiryAlert[]

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  @@index([plateNumber])
  @@index([vehicleId])
  @@index([vin])
  @@index([status])
  @@index([registrationExpiryDate])
  @@index([insuranceExpiryDate])
  @@index([inspectionExpiryDate])
  @@map("vehicles")
}

// ----------------------------------------------------
// VEHICLE-WORKER ASSIGNMENTS
// ----------------------------------------------------

model VehicleAssignment {
  id           String    @id @default(uuid())
  vehicleId    String
  workerId     String
  assignedFrom DateTime  @default(now())
  assignedTo   DateTime?
  isCurrent    Boolean   @default(true)
  notes        String?   @db.Text

  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  worker       Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vehicleId])
  @@index([workerId])
  @@index([isCurrent])
  @@map("vehicle_assignments")
}

// ----------------------------------------------------
// DOCUMENTS & FILES
// ----------------------------------------------------

model FileRecord {
  id           String    @id @default(uuid())
  originalName String
  storedName   String    @unique
  mimeType     String
  sizeBytes    BigInt
  storagePath  String
  s3Bucket     String?
  s3Key        String?
  uploadedById String?
  isPrivate    Boolean   @default(true)
  checksumSha  String?

  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([storedName])
  @@map("file_records")
}

model VehicleDocument {
  id             String         @id @default(uuid())
  vehicleId      String
  documentType   VehicleDocType @default(OTHER)
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String
  fileName       String
  fileMimeType   String?
  fileSize       String?
  uploadedBy     String?
  notes          String?        @db.Text

  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([vehicleId])
  @@index([documentType])
  @@index([expiryDate])
  @@map("vehicle_documents")
}

model WorkerDocument {
  id             String        @id @default(uuid())
  workerId       String
  documentType   WorkerDocType @default(OTHER)
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String
  fileName       String
  fileMimeType   String?
  fileSize       String?
  uploadedBy     String?
  notes          String?       @db.Text

  worker         Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([workerId])
  @@index([documentType])
  @@index([expiryDate])
  @@map("worker_documents")
}

// ----------------------------------------------------
// INSURANCE, REGISTRATION, INSPECTION RECORDS
// ----------------------------------------------------

model VehicleInsurance {
  id           String    @id @default(uuid())
  vehicleId    String
  company      String
  policyNumber String
  issueDate    DateTime?
  expiryDate   DateTime
  premium      Decimal   @default(0.0) @db.Decimal(12, 2)
  coverageType String?   @default("COMPREHENSIVE") // COMPREHENSIVE, THIRD_PARTY
  documentId   String?
  notes        String?   @db.Text

  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("vehicle_insurances")
}

model VehicleRegistration {
  id                 String    @id @default(uuid())
  vehicleId          String
  registrationNumber String
  issueDate          DateTime?
  expiryDate         DateTime
  documentId         String?
  notes              String?   @db.Text

  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("vehicle_registrations")
}

model VehicleInspection {
  id               String           @id @default(uuid())
  vehicleId        String
  inspectionDate   DateTime
  expiryDate       DateTime
  inspectionCenter String?          @default("MVPI - Saudi SASO Fahs")
  result           InspectionResult @default(PASSED)
  documentId       String?
  notes            String?          @db.Text

  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("vehicle_inspections")
}

// ----------------------------------------------------
// MAINTENANCE, FUEL & EXPENSES
// ----------------------------------------------------

model MaintenanceRecord {
  id                     String          @id @default(uuid())
  vehicleId              String
  maintenanceType        MaintenanceType @default(PERIODIC_SERVICE)
  date                   DateTime
  mileage                Int
  workshop               String
  description            String          @db.Text
  partsDescription       String?         @db.Text
  partsCost              Decimal         @default(0.0) @db.Decimal(12, 2)
  laborCost              Decimal         @default(0.0) @db.Decimal(12, 2)
  totalCost              Decimal         @default(0.0) @db.Decimal(12, 2)
  nextMaintenanceDate    DateTime?
  nextMaintenanceMileage Int?
  invoiceUrl             String?
  notes                  String?         @db.Text

  vehicle                Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([vehicleId])
  @@index([date])
  @@map("maintenance_records")
}

model FuelRecord {
  id            String    @id @default(uuid())
  vehicleId     String
  workerId      String?
  date          DateTime
  fuelType      FuelType  @default(DIESEL)
  liters        Decimal   @db.Decimal(10, 2)
  pricePerLiter Decimal   @default(1.15) @db.Decimal(6, 3)
  totalCost     Decimal   @db.Decimal(12, 2)
  mileage       Int
  fuelStation   String
  receiptUrl    String?
  notes         String?   @db.Text

  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  worker        Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([vehicleId])
  @@index([workerId])
  @@index([date])
  @@map("fuel_records")
}

model ExpenseRecord {
  id            String          @id @default(uuid())
  vehicleId     String?
  workerId      String?
  category      ExpenseCategory @default(OTHER)
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime
  vendor        String
  invoiceNumber String?
  description   String          @db.Text
  receiptUrl    String?
  createdBy     String?

  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  worker        Worker?         @relation(fields: [workerId], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([vehicleId])
  @@index([workerId])
  @@index([category])
  @@index([date])
  @@map("expense_records")
}

// ----------------------------------------------------
// EXPIRY ALERTS & NOTIFICATIONS
// ----------------------------------------------------

model ExpiryAlert {
  id             String        @id @default(uuid())
  entityType     String        // "VEHICLE" | "WORKER"
  entityId       String
  vehicleId      String?
  workerId       String?
  documentType   String        // "IQAMA", "ISTIMARA", "INSURANCE", "INSPECTION", "PASSPORT", etc.
  documentNumber String?
  expiryDate     DateTime
  daysRemaining  Int
  status         AlertStatus
  priority       AlertPriority @default(MEDIUM)
  isAcknowledged Boolean       @default(false)
  lastCheckedAt  DateTime      @default(now())

  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  worker         Worker?       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([entityType, entityId, documentType])
  @@index([status])
  @@index([priority])
  @@index([expiryDate])
  @@index([daysRemaining])
  @@map("expiry_alerts")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  type       String   @default("EXPIRY_ALERT") // "EXPIRY_ALERT", "MAINTENANCE_DUE", "SYSTEM", "SECURITY"
  title      String
  message    String   @db.Text
  entityType String?
  entityId   String?
  priority   String   @default("MEDIUM")
  isRead     Boolean  @default(false)

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ----------------------------------------------------
// AUDIT LOGGING
// ----------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  userName    String?
  userRole    String?
  action      AuditAction
  entityType  String
  entityId    String?
  oldValue    String?     @db.Text // JSON string
  newValue    String?     @db.Text // JSON string
  ipAddress   String?
  userAgent   String?
  description String?     @db.Text
  timestamp   DateTime    @default(now())

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
  @@map("audit_logs")
}

// ----------------------------------------------------
// SYSTEM SETTINGS & COMPANY PROFILE
// ----------------------------------------------------

model CompanyProfile {
  id          String   @id @default(uuid())
  name        String
  nameAr      String?
  crNumber    String?  // Commercial Registration 10 digits
  vatNumber   String?  // 15 digits VAT number
  address     String?
  addressAr   String?
  phone       String?
  email       String?
  managerName String?
  currency    String   @default("SAR")
  timezone    String   @default("Asia/Riyadh")
  logoUrl     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_profiles")
}
